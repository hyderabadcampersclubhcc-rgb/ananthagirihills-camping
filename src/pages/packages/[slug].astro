---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import Rich from '@/components/Rich.astro';
import Faq from '@/components/Faq.astro';
import BookingBox from '@/components/BookingBox.astro';
import StickyCta from '@/components/StickyCta.astro';
import PackageCard from '@/components/PackageCard.astro';
import { photos } from '@/data/photos';
import { campsitePhotos } from '@/lib/gallery';
import { url, inr } from '@/lib/url';
import { CONFIRM, whatsappLink } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const packages = await getCollection('packages');
  return packages.map((pkg) => ({ params: { slug: pkg.id }, props: { pkg } }));
}

interface Props {
  pkg: CollectionEntry<'packages'>;
}

const { pkg } = Astro.props;
const d = pkg.data;
const { Content } = await render(pkg);
const others = (await getCollection('packages')).filter((p) => p.id !== pkg.id).sort((a, b) => a.data.order - b.data.order);
const real = campsitePhotos(pkg.id);
const shareImage = real[0]?.src ?? photos[d.photos[0]].src;
const pageUrl = new URL(url(`packages/${pkg.id}/`), Astro.site).href;
const home = new URL(url(), Astro.site).href;

const facts = [
  ['Duration', '1 night / 2 days'],
  ['Price', `From ${inr(d.price)} per person, meals included`],
  ['Advance', d.advance ? `${inr(d.advance)} per person, non-refundable` : CONFIRM],
  ['Runs', d.runs],
  ['Campsite', d.campsite],
  ['Check-in', d.checkIn],
  ['Check-out', d.checkOut],
  ['Stay', `${d.stay.tent} · ${d.stay.washroom}`],
  ['Transport', 'Not included: you reach the campsite yourself'],
  ['Best suited for', d.suitableFor.join(', ')],
];

const productImage = (await getImage({ src: shareImage, width: 1200, format: 'jpg' })).src;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': `${pageUrl}#package`,
      name: d.title,
      description: d.summary,
      image: new URL(productImage, Astro.site).href,
      category: 'Camping package',
      brand: { '@id': `${home}#business` },
      offers: {
        '@type': 'Offer',
        url: pageUrl,
        price: d.price,
        priceCurrency: 'INR',
        description: `Per person for 1 night / 2 days, meals included. ${d.runs}.`,
        seller: { '@id': `${home}#business` },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: home },
        { '@type': 'ListItem', position: 2, name: 'Camping packages', item: `${home}#packages` },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={d.seoTitle}
  description={d.seoDescription}
  image={shareImage}
  imageAlt={real[0] ? `${real[0].caption} at ${d.campsite}` : photos[d.photos[0]].alt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="wrap" data-package={d.title}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={url()}>Home</a></li>
        <li><a href={url('#packages')}>Camping packages</a></li>
        <li><span aria-current="page">{d.title}</span></li>
      </ol>
    </nav>

    <header class="intro">
      <ul class="chips">{d.tags.map((t) => <li>{t}</li>)}</ul>
      <h1>{d.title}</h1>
      <p class="intro__site">{d.campsiteShort} · {d.location}</p>
      <p class="lead">{d.summary}</p>
    </header>

    <Gallery packageId={pkg.id} campsite={d.campsiteShort} fallback={d.photos} />

    <div class="layout">
      <aside class="side" aria-label="Enquire about this camp">
        <BookingBox title={d.title} price={d.price} advance={d.advance} runs={d.runs} />
      </aside>

      <div class="content">
        <section aria-labelledby="glance">
          <h2 id="glance">At a glance</h2>
          <dl class="facts">
            {
              facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd><Rich text={v} topic={d.title} /></dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section aria-labelledby="overview">
          <h2 id="overview">Overview</h2>
          <div class="prose"><Content /></div>
          <h3>Highlights</h3>
          <ul class="ticks">{d.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>

        <section aria-labelledby="itinerary">
          <h2 id="itinerary">Itinerary</h2>
          <ol class="days">
            {
              d.itinerary.map((day, i) => (
                <li>
                  <p class="days__label">Day {i + 1}</p>
                  <h3>{day.title}</h3>
                  <p><Rich text={day.text} topic={d.title} /></p>
                  <p class="days__meals">Meals: {day.meals}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="meals">
          <h2 id="meals">Meals</h2>
          <ul class="meals">
            {
              d.meals.map((m) => (
                <li>
                  <strong>{m.name}</strong>
                  <span><Rich text={m.detail} topic={`the meals at ${d.title}`} /></span>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="inclusions">
          <h2 id="inclusions">What's included and what's not</h2>
          <div class="two">
            <div>
              <h3>Included</h3>
              <ul class="ticks">{d.included.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
            </div>
            <div>
              <h3>Not included</h3>
              <ul class="ticks ticks--no">{d.notIncluded.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
            </div>
          </div>
        </section>

        <section aria-labelledby="stay">
          <h2 id="stay">Where you'll stay</h2>
          <div class="panel">
            <h3>{d.campsite}</h3>
            <p>{d.stay.description}</p>
            <p class="muted">{d.stay.tent} · {d.stay.washroom}</p>
          </div>
        </section>

        <section aria-labelledby="location">
          <h2 id="location">Location and how to get there</h2>
          <div class="panel">
            <p><strong>Where:</strong> {d.campsite}. {d.location}.</p>
            <p><strong>Getting there:</strong> {d.gettingThere}. Transport is not included.</p>
            <p><strong>Return:</strong> {d.returns}.</p>
            {
              d.trains.length > 0 && (
                <>
                  <h3>Trains to Vikarabad</h3>
                  <ul class="trains">
                    {d.trains.map((t) => (
                      <li>
                        <strong>{t.time}</strong> {t.from}
                        <br />
                        <span class="muted">{t.note}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }
            <p class="muted">
              {
                d.mapUrl ? (
                  <a class="btn btn--small" href={d.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
                ) : (
                  <>Exact directions and the map pin are shared on WhatsApp after you enquire.</>
                )
              }
            </p>
            <p class="muted">More on roads, trains and the best time to visit: <a href={url('ananthagiri-hills-guide/')}>Ananthagiri Hills travel guide</a>.</p>
          </div>
        </section>

        <section aria-labelledby="know">
          <h2 id="know">Good to know</h2>
          <div class="two">
            <div>
              <h3>Things to carry</h3>
              <ul class="ticks">{d.carry.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h3>Great for</h3>
              <ul class="ticks">{d.suitableFor.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <h3>Rules and safety</h3>
          <ul class="bullets">{d.important.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
        </section>

        <section aria-labelledby="payment">
          <h2 id="payment">Payment and cancellation</h2>
          <ul class="bullets">{d.payment.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
          <p><a href={url('cancellation-policy/')}>Read the full cancellation &amp; refund policy</a></p>
        </section>

        <section aria-labelledby="faqs">
          <h2 id="faqs">Questions about this camp</h2>
          <Faq faqs={d.faqs} topic={d.title} />
        </section>
      </div>
    </div>

    <section class="band" aria-labelledby="ask-h">
      <h2 id="ask-h">Questions before you enquire?</h2>
      <p>Ask us anything about {d.title}: dates, tents, food, travelling solo. A real person replies.</p>
      <a class="btn btn--light" href={whatsappLink(`Hi, I have a question about ${d.title}.`)} target="_blank" rel="noopener">WhatsApp us</a>
    </section>

    <section class="section" aria-labelledby="more">
      <h2 id="more">Compare with the other campsites</h2>
      <p class="lead"><a href={url('#compare')}>See all four side by side</a></p>
      <div class="grid">{others.map((p) => <PackageCard pkg={p} />)}</div>
    </section>
  </main>

  <StickyCta price={d.price} target="enquire" />
</BaseLayout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--color-muted);
    padding-top: 1.25rem;
  }
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .crumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 0.35rem;
  }
  .intro {
    padding: 1rem 0 1.25rem;
  }
  h1 {
    font-size: clamp(1.7rem, 5vw, 2.6rem);
    margin: 0.6rem 0 0.35rem;
  }
  .intro__site {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--color-accent-dark);
  }
  .layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  .content {
    display: grid;
    gap: 2.75rem;
    min-width: 0;
  }
  .content h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.6rem;
  }
  .facts {
    margin: 0;
    display: grid;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }
  .facts div {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .facts dd {
    margin: 0;
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .days,
  .meals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .days li {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }
  .days h3 {
    margin: 0.1rem 0 0.5rem;
  }
  .days p {
    margin: 0;
  }
  .days__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }
  .days .days__meals {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .meals {
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }
  .meals li {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .meals li:last-child {
    border-bottom: 0;
  }
  .meals span {
    color: var(--color-muted);
  }
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }
  .panel h3 {
    margin-top: 0;
  }
  .panel p {
    margin: 0 0 0.6rem;
  }
  .muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .trains {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .two {
    display: grid;
    gap: 0.5rem 2rem;
  }
  .two h3 {
    margin-top: 0;
  }
  .bullets {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
  }
  .band {
    margin-top: 3rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .band p {
    margin: 0 auto 1.25rem;
    max-width: 36rem;
    color: #e3efe8;
  }
  .section .lead {
    margin-top: -0.5rem;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 600px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
    .meals li {
      grid-template-columns: 14rem 1fr;
      gap: 1rem;
    }
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
    .side {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 5rem;
    }
    .content {
      grid-column: 1;
      grid-row: 1;
    }
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
