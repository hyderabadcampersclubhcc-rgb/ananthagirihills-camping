---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import Rich from '@/components/Rich.astro';
import Faq from '@/components/Faq.astro';
import BookingBox from '@/components/BookingBox.astro';
import PackageCard from '@/components/PackageCard.astro';
import { url, inr } from '@/lib/url';
import { whatsappLink } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const packages = await getCollection('packages');
  return packages.map((pkg) => ({ params: { slug: pkg.id }, props: { pkg } }));
}

interface Props {
  pkg: CollectionEntry<'packages'>;
}

const { pkg } = Astro.props;
const d = pkg.data;
const { Content } = await render(pkg);
const others = (await getCollection('packages')).filter((p) => p.id !== pkg.id).sort((a, b) => a.data.order - b.data.order);
const facts = [
  ['Duration', '1 night / 2 days'],
  ['Price', `From ${inr(d.price)} per person`],
  ['Runs', d.runs],
  ['Campsite', d.campsite],
  ['Check-in', d.checkIn],
  ['Check-out', d.checkOut],
  ['Getting there', d.gettingThere],
  ['Stay', `${d.stay.tent} · ${d.stay.washroom}`],
  ['Best suited for', d.suitableFor.join(', ')],
];
const [lead, ...rest] = d.photos;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url(), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.title, item: new URL(url(`packages/${pkg.id}/`), Astro.site).href },
  ],
};
---

<BaseLayout title={`${d.title} | From ${inr(d.price)} per person`} description={d.summary}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url()}>Home</a> › <span>{d.title}</span></nav>

    <header class="intro">
      <ul class="chips">{d.tags.map((t) => <li>{t}</li>)}</ul>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </header>

    <div class="gallery" data-count={d.photos.length}>
      <Photo name={lead} sizes="(min-width: 960px) 60vw, 100vw" loading="eager" class="gallery__lead" />
      {rest.slice(0, 2).map((name) => <Photo name={name} sizes="(min-width: 960px) 30vw, 50vw" />)}
    </div>

    <div class="layout">
      <div class="content">
        <section aria-labelledby="glance">
          <h2 id="glance">At a glance</h2>
          <dl class="facts">
            {
              facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd><Rich text={v} topic={d.title} /></dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section aria-labelledby="overview">
          <h2 id="overview">Overview</h2>
          <div class="prose"><Content /></div>
          <h3>Highlights</h3>
          <ul class="ticks">{d.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>

        <section aria-labelledby="itinerary">
          <h2 id="itinerary">Itinerary</h2>
          <ol class="days">
            {
              d.itinerary.map((day, i) => (
                <li>
                  <p class="days__label">Day {i + 1}</p>
                  <h3>{day.title}</h3>
                  <p><Rich text={day.text} topic={d.title} /></p>
                  <p class="days__meals">Meals: {day.meals}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="stay">
          <h2 id="stay">Stay &amp; getting there</h2>
          <div class="panel">
            <h3>{d.campsite}</h3>
            <p>{d.stay.description}</p>
            <p class="muted">{d.stay.tent} · {d.stay.washroom} · {d.location}</p>
          </div>
          <div class="panel">
            <h3>Getting to the campsite (you travel on your own)</h3>
            <p><strong>Outbound:</strong> {d.gettingThere}</p>
            <p><strong>Return:</strong> {d.returns}</p>
            {
              d.trains.length > 0 && (
                <ul class="trains">
                  {d.trains.map((t) => (
                    <li>
                      <strong>{t.time}</strong> {t.from}
                      <br />
                      <span class="muted">{t.note}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </section>

        <section aria-labelledby="inclusions">
          <h2 id="inclusions">What's included</h2>
          <div class="two">
            <div>
              <h3>Included</h3>
              <ul class="ticks">{d.included.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
            </div>
            <div>
              <h3>Not included</h3>
              <ul class="ticks ticks--no">{d.notIncluded.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
            </div>
          </div>
        </section>

        <section aria-labelledby="know">
          <h2 id="know">Good to know</h2>
          <div class="two">
            <div>
              <h3>Things to carry</h3>
              <ul class="ticks">{d.carry.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h3>Great for</h3>
              <ul class="ticks">{d.suitableFor.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <h3>Important</h3>
          <ul class="bullets">{d.important.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
        </section>

        <section aria-labelledby="payment">
          <h2 id="payment">Payment &amp; cancellation</h2>
          <ul class="bullets">{d.payment.map((x) => <li><Rich text={x} topic={d.title} /></li>)}</ul>
          <p><a href={url('cancellation-policy/')}>Read the full cancellation policy</a></p>
        </section>

        <section aria-labelledby="faqs">
          <h2 id="faqs">Questions about this camp</h2>
          <Faq faqs={d.faqs} topic={d.title} />
        </section>
      </div>

      <aside class="side" aria-label="Book this camp">
        <BookingBox title={d.title} price={d.price} advance={d.advance} runs={d.runs} />
      </aside>
    </div>

    <section class="band">
      <h2>Questions before you book?</h2>
      <p>Ask us anything about {d.title}: dates, tents, travelling solo. A real person replies.</p>
      <a class="btn btn--light" href={whatsappLink(`Hi, I have a question about ${d.title}.`)} target="_blank" rel="noopener">WhatsApp us</a>
    </section>

    <section class="section" aria-labelledby="more">
      <h2 id="more">Other campsites</h2>
      <div class="grid">{others.map((p) => <PackageCard pkg={p} />)}</div>
    </section>
  </main>
</BaseLayout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--color-muted);
    padding-top: 1.25rem;
  }
  .intro {
    padding: 1rem 0 1.25rem;
  }
  h1 {
    font-size: clamp(1.7rem, 5vw, 2.6rem);
    margin: 0.6rem 0 0.5rem;
  }
  .gallery {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr 1fr;
  }
  .gallery :global(.gallery__lead) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .gallery > :global(figure:not(.gallery__lead)) {
    aspect-ratio: 4 / 3;
  }
  .layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  .content {
    display: grid;
    gap: 2.75rem;
    min-width: 0;
  }
  .content h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.6rem;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }
  .facts div {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .facts dd {
    margin: 0;
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .days {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .days li {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }
  .days h3 {
    margin: 0.1rem 0 0.5rem;
  }
  .days p {
    margin: 0;
  }
  .days__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }
  .days .days__meals {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    margin-bottom: 1rem;
  }
  .panel h3 {
    margin-top: 0;
  }
  .panel p {
    margin: 0 0 0.5rem;
  }
  .muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .trains {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .two {
    display: grid;
    gap: 0.5rem 2rem;
  }
  .two h3 {
    margin-top: 0;
  }
  .bullets {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
  }
  .band {
    margin-top: 3rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .band p {
    margin: 0 auto 1.25rem;
    max-width: 36rem;
    color: #e3efe8;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 600px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
  @media (min-width: 960px) {
    .gallery {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 1fr 1fr;
      height: 26rem;
    }
    .gallery :global(.gallery__lead) {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
    }
    .gallery > :global(figure:not(.gallery__lead)) {
      aspect-ratio: auto;
    }
    .gallery[data-count='2'] > :global(figure:not(.gallery__lead)) {
      grid-row: 1 / span 2;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
    .side {
      position: sticky;
      top: 5rem;
    }
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 959px) {
    .side {
      order: -1;
    }
  }
</style>
