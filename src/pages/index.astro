---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import PackageCard from '@/components/PackageCard.astro';
import CompareTable from '@/components/CompareTable.astro';
import Faq from '@/components/Faq.astro';
import Rich from '@/components/Rich.astro';
import Reviews from '@/components/Reviews.astro';
import { url, inr } from '@/lib/url';
import { whatsappLink } from '@/lib/whatsapp';

const packages = (await getCollection('packages')).sort((a, b) => a.data.order - b.data.order);
const from = Math.min(...packages.map((p) => p.data.price));

const night = [
  ['Arrive in the afternoon', 'Make your own way to the campsite and check in during the afternoon. The exact time varies by campsite; for yours, Contact us on WhatsApp to confirm.'],
  ['Play until dark', 'Evening tea and snacks, then the campsite’s activities: a pool, a rope course, lakeside games or sports, depending on where you stay.'],
  ['Fire, dinner and a tent', 'A bonfire or campfire once it is dark, dinner, and a night in a tent shared by 2 or 3 people.'],
  ['Breakfast and home', 'Breakfast in the morning (the premium camp adds a 6 am sunrise trek), and check-out at 11 am.'],
];

const audiences = [
  ['Couples', 'The budget camp, Sarpanpally Lake and the premium camp all list couples among their guests. The resort hosting the adventure camp does not permit unmarried couples; that is the resort’s own rule.'],
  ['Families and first-timers', 'All four are organised campsites with tents, meals and washrooms, so you do not need any camping gear or experience. Children’s policy: Contact us on WhatsApp to confirm.'],
  ['Friends and solo travellers', 'Prices are per person, so it costs the same whether you come alone or with a group. The budget camp is the one that lists solo travellers.'],
  ['Office groups', 'The adventure camp’s rope course, cycling and team games suit office outings. Group size: Contact us on WhatsApp to confirm.'],
  ['Night camping', 'Every package is an overnight stay: an evening of activities, a fire after dark and a night in a tent. The adventure camp, Sarpanpally Lake and the premium camp run on Saturday nights.'],
];

const faqs = [
  { q: 'Where can I go camping near Hyderabad?', a: 'In the Ananthagiri Hills near Vikarabad, roughly 80 km west of the city. We offer four campsites there: a budget camp with a pool, an adventure camp with a rope course, a lakeside camp at Sarpanpally Lake and a premium camp with a sunrise trek.' },
  { q: 'How much does camping near Hyderabad cost?', a: 'Prices are per person for one night including meals: ₹1,600 for the budget camp, ₹2,000 for the adventure camp, ₹2,000 at Sarpanpally Lake and ₹2,999 for the premium camp. Each package page lists what that price covers.' },
  { q: 'Is transport included?', a: 'No, at all four campsites you travel on your own. It is about 2 to 2.5 hours by road, or you can take a train or bus to Vikarabad and an auto or cab for the last stretch.' },
  { q: 'Will I share a tent?', a: 'Yes. Depending on the campsite, tents take 2 or 3 people. If you have a particular request, ask us on WhatsApp.' },
  { q: 'What does a camping night include?', a: 'Everywhere: a tent for the night, evening tea, dinner, breakfast and a bonfire or campfire. The activities are what differ, from a pool and Saturday DJ to a rope course, lakeside games or a sunrise trek.' },
  { q: 'When is the best time to camp near Hyderabad?', a: 'From July to February, when the Ananthagiri Hills are green after the monsoon and the nights are cooler. The adventure camp, Sarpanpally Lake and the premium camp run on Saturdays; for any date, check availability with us on WhatsApp.' },
  { q: 'Can I go camping near Hyderabad without a car?', a: 'Yes. Trains 12702 (from Nampally) and 12732 (from Secunderabad) and TSRTC buses go to Vikarabad, and an auto or cab takes you on to the campsite.' },
  { q: 'Is camping suitable for families and first-timers?', a: 'Yes. These are organised campsites with tents, meals and washrooms, not wild camping, so you need no gear or experience.' },
  { q: 'Which Ananthagiri campsites have a swimming pool?', a: 'Two of them: the budget camp, where the pool is open from 5 to 10 pm, and the premium camp, where it is open from 4 to 6 pm.' },
  { q: 'Is there lakeside camping near Hyderabad?', a: 'Yes. At Sarpanpally Lake, near Godamguda village in Vikarabad, the tents stand on the lake bank, roughly 80 to 90 km from Hyderabad.' },
  { q: 'What time is check-in and check-out?', a: 'The budget camp checks in at 4 pm. Check-in time at the adventure camp, Sarpanpally Lake and the premium camp: Contact us on WhatsApp to confirm. All four check out at 11 am the next morning.' },
  { q: 'How do I book, and is the advance refundable?', a: 'Send an enquiry on WhatsApp with your date and number of guests. Once we confirm availability, a ₹500 advance per person reserves your place; the advance is non-refundable. The cancellation & refund policy has the details.' },
  { q: 'Are there extra charges at the campsites?', a: 'The price covers what each package page lists as included; food and drinks beyond the included meals cost extra everywhere. Optional paid activities at Sarpanpally Lake and their charges: Contact us on WhatsApp to confirm.' },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ananthagiri Hills camping packages',
  itemListElement: packages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: new URL(url(`packages/${p.id}/`), Astro.site).href,
  })),
};
---

<BaseLayout
  title="Camping near Hyderabad: Ananthagiri Hills Packages from ₹1,600"
  description="Compare 4 overnight camps in the Ananthagiri Hills, about 2 hours from Hyderabad: pool, adventure, lakeside and premium. Tents, meals and bonfire from ₹1,600."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main>
    <section class="hero">
      <Photo name="campfire" sizes="100vw" loading="eager" class="hero__photo" />
      <div class="wrap hero__inner">
        <p class="hero__kicker">Ananthagiri Hills · Vikarabad</p>
        <h1>Camping near Hyderabad</h1>
        <p class="hero__lead">
          Spend a night in a tent in the forested Ananthagiri Hills, around two hours' drive from Hyderabad. Pick the camp that fits you:
          a pool with a Saturday DJ, a rope course and cycling, tents on a lake bank, or a private campsite with a guided sunrise trek.
        </p>
        <ul class="hero__facts">
          <li><strong>4</strong> campsites</li>
          <li>From <strong>{inr(from)}</strong> /person</li>
          <li><strong>1N / 2D</strong> with meals</li>
        </ul>
        <div class="hero__cta">
          <a class="btn" href="#packages">See camping packages</a>
          <a class="btn btn--light" href={whatsappLink('Hi, I want to check camping availability in Ananthagiri Hills.')} target="_blank" rel="noopener">
            Check availability
          </a>
        </div>
      </div>
    </section>

    <section class="wrap section" id="packages" aria-labelledby="packages-h">
      <h2 id="packages-h">Ananthagiri Hills camping packages and prices</h2>
      <p class="lead">One price per person at each campsite, covering your tent, evening tea, dinner and breakfast. Getting there is up to you.</p>
      <div class="grid">{packages.map((p) => <PackageCard pkg={p} />)}</div>
    </section>

    <section class="wrap section" id="compare" aria-labelledby="compare-h">
      <h2 id="compare-h">Compare the campsites</h2>
      <p class="lead">Price, advance, tents, check-in and check-out, meals, activities and what is not included, side by side.</p>
      <CompareTable />
    </section>

    <section class="wrap section" aria-labelledby="choose-h">
      <h2 id="choose-h">Which campsite suits you?</h2>
      <ul class="choose">
        {
          packages.map((p) => (
            <li>
              <p class="choose__for">{p.data.compare.bestFor}</p>
              <p>{p.data.chooser}</p>
              <a href={url(`packages/${p.id}/`)}>
                {p.data.title} <span class="sr-only">({p.data.campsiteShort})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap section" aria-labelledby="who-h">
      <h2 id="who-h">Camping for couples, families, friends and office groups</h2>
      <ul class="who">
        {
          audiences.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p><Rich text={text} topic={`camping for ${title.toLowerCase()}`} /></p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap section" aria-labelledby="night-h">
      <h2 id="night-h">How a night of camping near Hyderabad works</h2>
      <ol class="steps">
        {
          night.map(([title, text], i) => (
            <li>
              <span class="steps__n">{i + 1}</span>
              <h3>{title}</h3>
              <p><Rich text={text} topic="camping check-in times" /></p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap section split" aria-labelledby="when-h">
      <div>
        <h2 id="when-h">When to go and how to get there</h2>
        <p>
          July to February is the best time for the Ananthagiri Hills: green after the monsoon, with cooler nights. Most of the camps
          run on Saturdays, so you need no leave.
        </p>
        <p>
          The hills are near Vikarabad, about 80 km from Hyderabad: roughly 2 to 2.5 hours by road, or a train or TSRTC bus to
          Vikarabad and then an auto or cab. Transport is not included at any campsite.
        </p>
        <p><a class="btn btn--small" href={url('ananthagiri-hills-guide/')}>Read the Ananthagiri Hills travel guide</a></p>
      </div>
      <Photo name="ananthagiri" sizes="(min-width: 860px) 45vw, 100vw" class="split__photo" />
    </section>

    <section class="wrap section two" aria-label="Packing and camp rules">
      <div class="panel">
        <h2>What to carry</h2>
        <ul class="ticks">
          <li>A government photo ID for every guest</li>
          <li>Comfortable clothes and trekking or sports shoes</li>
          <li>A torch, and a light jacket or hoodie for the night</li>
          <li>Swimwear or an extra set of clothes if your camp has a pool</li>
          <li>Personal medicines and toiletries</li>
        </ul>
      </div>
      <div class="panel">
        <h2>Camp rules to know</h2>
        <ul class="ticks">
          <li>Arrive on time; late arrivals may miss meals and activities.</li>
          <li>Drugs, illegal activity and nuisance aren’t tolerated. Anyone breaking camp rules is asked to leave without a refund.</li>
          <li>Keep valuables with you.</li>
        </ul>
      </div>
    </section>

    <Reviews />

    <section class="wrap section" id="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions about camping near Hyderabad</h2>
      <Faq faqs={faqs} topic="camping near Hyderabad" />
    </section>

    <section class="wrap section">
      <div class="band">
        <h2>Still not sure which one to pick?</h2>
        <p>Tell us your dates and what you enjoy. A real person will suggest the right campsite.</p>
        <a class="btn btn--light" href={whatsappLink('Hi, which camping package would suit us?')} target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    color: #fff;
    min-height: 34rem;
    display: flex;
    align-items: flex-end;
  }
  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 20 15 / 0.25) 0%, rgb(10 20 15 / 0.8) 75%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }
  .hero__kicker {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cfe3d6;
  }
  h1 {
    font-size: clamp(2.2rem, 7vw, 3.75rem);
    margin: 0.4rem 0 0.75rem;
  }
  .hero__lead {
    max-width: 40rem;
    margin: 0;
    color: #e8efe9;
  }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: #e8efe9;
  }
  .hero__facts strong {
    color: #fff;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
  }
  .steps__n {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-sand);
    color: var(--color-accent-dark);
    font-weight: 700;
  }
  .steps h3 {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.05rem;
  }
  .steps p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .split {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .split p {
    color: var(--color-muted);
    margin: 0 0 1rem;
  }
  .who {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .who li {
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.9rem 1.1rem;
  }
  .who h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
  }
  .who p {
    margin: 0;
    color: var(--color-muted);
  }
  @media (min-width: 760px) {
    .who {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .choose {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .choose li {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .choose p {
    margin: 0;
    color: var(--color-muted);
  }
  .choose .choose__for {
    font-weight: 700;
    color: var(--color-text);
  }
  .choose a {
    font-weight: 600;
  }
  .split :global(.split__photo) {
    aspect-ratio: 4 / 3;
  }
  .two {
    display: grid;
    gap: 1.25rem;
  }
  .panel {
    background: var(--color-sand);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .panel h2 {
    font-size: 1.3rem;
  }
  .band {
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius);
    padding: 2.25rem 1.5rem;
    text-align: center;
  }
  .band p {
    margin: 0 auto 1.25rem;
    max-width: 36rem;
    color: #e3efe8;
  }
  @media (min-width: 600px) {
    .grid,
    .choose,
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 860px) {
    .split,
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .grid,
    .choose,
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
