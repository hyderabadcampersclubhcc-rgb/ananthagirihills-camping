---
/**
 * Page shell. Every page is noindex unless the build sets PUBLIC_ALLOW_INDEXING=true
 * (production only), so staging, preview and local builds can never be indexed by accident.
 */
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Consent from '@/components/Consent.astro';
import { trackingEnabled } from '@/lib/tracking';
import site from '@/data/site.json';
import { photos } from '@/data/photos';
import logo from '@/assets/brand/hcc-logo.png';
import { url } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Social share image (cropped to 1200x630); defaults to the site-wide image. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, noindex = false, image = photos.campfire.src, imageAlt = 'Tent under a starry night sky' } = Astro.props;
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, Astro.site).href;
const home = new URL(url(), Astro.site).href;
const touchIcon = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const logoForSearch = new URL((await getImage({ src: logo, width: 512, height: 512, format: 'png' })).src, Astro.site).href;

// The business behind the site, as shown in the footer. No address or rating until the owner supplies real ones.
const business = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TravelAgency',
      '@id': `${home}#business`,
      name: site.operator,
      url: home,
      telephone: site.phone.replace(/\s/g, ''),
      areaServed: 'Hyderabad, Telangana',
      sameAs: [site.mainSite],
      logo: logoForSearch,
      image: logoForSearch,
    },
    { '@type': 'WebSite', '@id': `${home}#website`, name: site.name, url: home, inLanguage: 'en-IN', publisher: { '@id': `${home}#business` } },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta name="theme-color" content="#2f6b4f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-body" preload />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <div id="main" tabindex="-1">
      <slot />
    </div>
    <Footer />
    {trackingEnabled && <Consent />}
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fbfaf7;
    --color-surface: #ffffff;
    --color-text: #1f2a24;
    --color-muted: #56625a;
    --color-accent: #2f6b4f;
    --color-accent-dark: #24543e;
    --color-sand: #f1ebdf;
    --color-dark: #1c2a22;
    --color-line: #e6e1d6;
    --color-line-strong: #cfc8b9;
    --radius: 14px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6.5rem;
  }
  @media (min-width: 760px) {
    html {
      scroll-padding-top: 4.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  :focus-visible {
    outline: 3px solid #e0a43a;
    outline-offset: 2px;
  }
  #main:focus {
    outline: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* Room for the mobile sticky enquiry bar so it never covers the footer. */
  body:has(.sticky-cta) {
    padding-bottom: 4.5rem;
  }
  @media (min-width: 960px) {
    body:has(.sticky-cta) {
      padding-bottom: 0;
    }
  }
  a {
    color: var(--color-accent);
  }
  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  h2 {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    margin: 0 0 1rem;
  }
  .wrap {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .section {
    padding: 3rem 0 0;
  }
  .lead {
    color: var(--color-muted);
    max-width: 44rem;
    margin-top: 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    padding: 0.75rem 1.4rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover {
    background: var(--color-accent-dark);
  }
  .btn--small {
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }
  .btn--light {
    background: #fff;
    color: var(--color-accent);
  }
  .btn--light:hover {
    background: var(--color-sand);
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chips li {
    background: var(--color-sand);
    color: var(--color-accent-dark);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 99px;
  }
  .price {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .price strong {
    color: var(--color-text);
    font-size: 1.3em;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .ticks li {
    position: relative;
    padding-left: 1.6rem;
  }
  .ticks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }
  .ticks--no li::before {
    content: '✕';
    color: #a4513f;
  }
  .confirm {
    font-weight: 600;
  }
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 44rem;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }
  thead th {
    background: var(--color-sand);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
</style>
