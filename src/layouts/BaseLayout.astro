---
/**
 * Page shell. Every page is noindex unless the build sets PUBLIC_ALLOW_INDEXING=true
 * (production only), so staging, preview and local builds can never be indexed by accident.
 */
import { Font } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { url } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--font-body" preload />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fbfaf7;
    --color-surface: #ffffff;
    --color-text: #1f2a24;
    --color-muted: #56625a;
    --color-accent: #2f6b4f;
    --color-accent-dark: #24543e;
    --color-sand: #f1ebdf;
    --color-dark: #1c2a22;
    --color-line: #e6e1d6;
    --color-line-strong: #cfc8b9;
    --radius: 14px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 4.5rem;
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  a {
    color: var(--color-accent);
  }
  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  h2 {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    margin: 0 0 1rem;
  }
  .wrap {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .section {
    padding: 3rem 0 0;
  }
  .lead {
    color: var(--color-muted);
    max-width: 44rem;
    margin-top: 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    padding: 0.75rem 1.4rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover {
    background: var(--color-accent-dark);
  }
  .btn--small {
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }
  .btn--light {
    background: #fff;
    color: var(--color-accent);
  }
  .btn--light:hover {
    background: var(--color-sand);
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chips li {
    background: var(--color-sand);
    color: var(--color-accent-dark);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 99px;
  }
  .price {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .price strong {
    color: var(--color-text);
    font-size: 1.3em;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .ticks li {
    position: relative;
    padding-left: 1.6rem;
  }
  .ticks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }
  .ticks--no li::before {
    content: '✕';
    color: #a4513f;
  }
  .confirm {
    font-weight: 600;
  }
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 44rem;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }
  thead th {
    background: var(--color-sand);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
</style>
