---
/**
 * Enquiry form: date (optional), guests and name, sent as a prefilled WhatsApp message.
 * It is an enquiry, never a booking: no availability is shown and no payment is taken here.
 */
import site from '@/data/site.json';
import { inr } from '@/lib/url';
import { CONFIRM, whatsappLink } from '@/lib/whatsapp';

interface Props {
  title: string;
  price: number;
  advance?: number;
  runs: string;
}

const { title, price, advance, runs } = Astro.props;
const fallback = whatsappLink(`Hi, I want to enquire about ${title}.`);
---

<form class="booking" id="enquire" data-booking data-title={title} data-price={price} data-advance={advance ?? ''} action={fallback} aria-labelledby="enquire-h">
  <h2 id="enquire-h" class="booking__h">Check availability</h2>
  <p class="price booking__price"><span>From</span> <strong>{inr(price)}</strong> <span>per person, meals included</span></p>
  <p class="booking__runs">{runs}</p>

  <label>
    Date you'd like to camp <span class="opt">(optional)</span>
    <input type="date" name="date" />
  </label>
  <label>
    Guests
    <input type="number" name="guests" min="1" max="50" value="2" required inputmode="numeric" />
  </label>
  <label>
    Your name
    <input type="text" name="name" autocomplete="name" required />
  </label>

  <dl class="booking__sum" aria-live="polite">
    <div><dt>Estimated total</dt><dd data-total>{inr(price * 2)}</dd></div>
    <div>
      <dt>Advance to reserve (non-refundable)</dt>
      <dd data-advance-out>{advance ? inr(advance * 2) : <a href={whatsappLink(`Hi, what is the advance for ${title}?`)} target="_blank" rel="noopener">{CONFIRM}</a>}</dd>
    </div>
  </dl>

  <button class="btn" type="submit">Send enquiry on WhatsApp</button>
  <p class="booking__note">
    <strong>This is an enquiry, not a booking.</strong> We reply on WhatsApp to confirm availability for your date. Your place is
    booked only after we confirm and you pay the advance.
  </p>
  <p class="booking__call">Prefer to talk? Call <a href={site.phoneHref}>{site.phone}</a></p>
</form>

<script>
  const inr = (n: number) => `₹${n.toLocaleString('en-IN')}`;
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-booking]')) {
    const { title, price, advance } = form.dataset;
    const total = form.querySelector('[data-total]')!;
    const adv = form.querySelector('[data-advance-out]')!;
    const guests = form.elements.namedItem('guests') as HTMLInputElement;
    const date = form.elements.namedItem('date') as HTMLInputElement;
    date.min = new Date().toISOString().slice(0, 10);

    const count = () => Math.min(50, Math.max(1, Math.round(Number(guests.value) || 1)));
    const update = () => {
      total.textContent = inr(count() * Number(price));
      if (advance) adv.textContent = inr(count() * Number(advance));
    };
    guests.addEventListener('input', update);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const n = count();
      const day = data.get('date')
        ? new Date(`${data.get('date')}T00:00`).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })
        : 'Flexible / not decided';
      const message = [
        `Hi, I'd like to enquire about ${title}.`,
        `Date: ${day}`,
        `Guests: ${n}`,
        `Name: ${String(data.get('name')).trim()}`,
        `Estimated total: ${inr(n * Number(price))}`,
        'Please confirm availability.',
      ].join('\n');
      // Measured only if tracking is on and the visitor accepted cookies (see Consent.astro).
      document.dispatchEvent(new CustomEvent('enquiry-sent', { detail: { title, guests: n, hasDate: Boolean(data.get('date')) } }));
      window.open(`${form.action.split('?')[0]}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    });
  }
</script>

<style>
  .booking {
    display: grid;
    gap: 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: 0 10px 30px rgb(31 42 36 / 0.08);
  }
  .booking__h {
    font-size: 1.15rem;
    margin: 0;
  }
  .booking__price {
    margin: 0;
  }
  .booking__runs {
    margin: -0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .opt {
    font-weight: 400;
    color: var(--color-muted);
  }
  input {
    font: inherit;
    font-weight: 400;
    padding: 0.6rem 0.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: #fff;
    color: var(--color-text);
    width: 100%;
  }
  .booking__sum {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    padding: 0.75rem 0;
    border-block: 1px solid var(--color-line);
    font-size: 0.92rem;
  }
  .booking__sum div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  dd a {
    font-weight: 500;
    font-size: 0.85rem;
  }
  .booking__note,
  .booking__call {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .booking__note strong {
    color: var(--color-text);
  }
</style>
