---
/** A stock/area photo with its visible "not the campsite" label and licence credit. */
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '@/data/photos';

interface Props {
  name: PhotoKey;
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { name, sizes, loading = 'lazy', class: className } = Astro.props;
const photo = photos[name];
---

<figure class:list={['photo', className]}>
  <Image
    src={photo.src}
    alt={photo.alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
  />
  <span class="photo__label">{photo.label}</span>
  <figcaption>
    Photo: <a href={photo.source} target="_blank" rel="noopener">{photo.author}</a> · {photo.license}
  </figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo__label {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 99px;
    max-width: calc(100% - 1rem);
  }
  figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 0.7rem;
    line-height: 1.3;
    max-width: 100%;
    padding: 0.15rem 0.5rem;
    border-top-left-radius: 6px;
  }
  figcaption a {
    color: #fff;
  }
</style>
