---
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '@/data/photos';

interface Props {
  name: PhotoKey;
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { name, sizes, loading = 'lazy', class: className } = Astro.props;
const photo = photos[name];
---

<figure class:list={['photo', className]}>
  <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes={sizes} loading={loading} />
  <figcaption>
    Photo: <a href={photo.source} target="_blank" rel="noopener">{photo.author}</a> · {photo.license}
  </figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-top-left-radius: 6px;
  }
  figcaption a {
    color: #fff;
  }
</style>
