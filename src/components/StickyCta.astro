---
/**
 * Phone-only bottom bar with the price and a button to the enquiry form. It hides while the form is on
 * screen, and the layout reserves space for it so it never covers the footer.
 */
import { inr } from '@/lib/url';

interface Props {
  price: number;
  target: string;
}

const { price, target } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta data-target={target}>
  <p class="price"><span>From</span> <strong>{inr(price)}</strong> <span>/person</span></p>
  <a class="btn" href={`#${target}`}>Check availability</a>
</div>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>('[data-sticky-cta]')) {
    const form = document.getElementById(bar.dataset.target!);
    if (!form) continue;
    new IntersectionObserver(([entry]) => {
      bar.classList.toggle('is-hidden', entry.isIntersecting);
      bar.inert = entry.isIntersecting;
    }).observe(form);
  }
</script>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 15;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom));
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -6px 20px rgb(31 42 36 / 0.08);
    transition: transform 0.2s ease;
  }
  .sticky-cta.is-hidden {
    transform: translateY(110%);
  }
  .sticky-cta .btn {
    padding: 0.65rem 1.2rem;
    white-space: nowrap;
  }
  .sticky-cta .price {
    white-space: nowrap;
  }
  @media (min-width: 960px) {
    .sticky-cta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
</style>
